{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:ai-business-skills:sales-playbook:1",
 "title": "Goi kich ban sale cho chatbot (sales-playbook)",
 "type": "object", "additionalProperties": false,
 "required": ["schema", "schema_version", "meta", "shop", "industry", "voice", "price_policy", "surfaces", "intents", "handoff", "never_say", "autonomy"],
 "properties": {
  "schema": {"const": "ai-business-skills/sales-playbook"},
  "schema_version": {"type": "string", "pattern": "^1\\.\\d+\\.\\d+$"},
  "meta": {"$ref": "#/$defs/meta"},
  "shop": {"$ref": "#/$defs/shop"},
  "industry": {"$ref": "#/$defs/industry"},
  "bot_profile": {"$ref": "#/$defs/bot_profile"},
  "voice": {"$ref": "#/$defs/voice"},
  "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
  "price_policy": {"$ref": "#/$defs/price_policy"},
  "products": {"type": "array", "items": {"$ref": "#/$defs/product"}},
  "post_product_map": {"type": "array", "items": {"$ref": "#/$defs/post_map"}},
  "surfaces": {"type": "object", "additionalProperties": false, "required": ["inbox", "public_comment"],
   "properties": {"inbox": {"$ref": "#/$defs/surface_rules"}, "public_comment": {"$ref": "#/$defs/surface_rules"}}},
  "intents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/intent"}},
  "faq": {"type": "array", "items": {"$ref": "#/$defs/faq"}},
  "objections": {"type": "array", "items": {"$ref": "#/$defs/objection"}},
  "closing": {"$ref": "#/$defs/closing"},
  "handoff": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handoff"}},
  "never_say": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/never_say"}},
  "autonomy": {"$ref": "#/$defs/autonomy"},
  "examples": {"type": "array", "items": {"$ref": "#/$defs/conversation"}},
  "missing": {"type": "array", "items": {"$ref": "#/$defs/missing"}},
  "evals": {"type": "array", "items": {"$ref": "#/$defs/eval_case"}},
  "exports": {"$ref": "#/$defs/exports"}
 },
 "$defs": {
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
  "ref": {"type": "string", "pattern": "^S[0-9]+$"},
  "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "evidence": {"enum": ["observed", "reported", "inferred"]},
  "surface": {"enum": ["inbox", "public_comment"]},
  "line": {"type": "string", "minLength": 1, "maxLength": 240},
  "utterances": {"type": "object", "additionalProperties": false, "required": ["text"],
   "properties": {"text": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 200}},
                  "ascii": {"type": "array", "items": {"type": "string", "maxLength": 200}}}},
  "template": {"type": "object", "additionalProperties": false, "required": ["id", "surface", "text"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "surface": {"enum": ["inbox", "public_comment", "both"]},
                  "text": {"type": "string", "maxLength": 600}, "slots": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}}}},
  "messages": {"type": "array", "minItems": 1, "maxItems": 40,
   "items": {"type": "object", "additionalProperties": false, "required": ["sender", "text"],
             "properties": {"sender": {"enum": ["customer", "bot"]}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
  "source": {"type": "object", "additionalProperties": false, "required": ["id", "type", "evidence"],
   "properties": {"id": {"$ref": "#/$defs/ref"}, "type": {"enum": ["pos_catalog", "chat_history", "script_file", "owner_input", "post_list"]},
                  "label": {"type": "string", "maxLength": 160}, "as_of": {"$ref": "#/$defs/date"}, "size": {"type": "integer", "minimum": 0},
                  "evidence": {"$ref": "#/$defs/evidence"}}},
  "meta": {"type": "object", "additionalProperties": false, "required": ["skill", "generated_at", "language", "status", "modes", "pii_redacted", "sources"],
   "properties": {"skill": {"type": "string", "pattern": "^77-"}, "generated_at": {"$ref": "#/$defs/date"}, "language": {"enum": ["vi", "en"]},
                  "status": {"enum": ["draft", "approved"]}, "is_example": {"type": "boolean"},
                  "modes": {"type": "array", "minItems": 1, "items": {"enum": ["from_catalog", "from_history", "from_script"]}},
                  "pii_redacted": {"type": "boolean"}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}},
   "allOf": [{"if": {"properties": {"modes": {"contains": {"const": "from_history"}}}, "required": ["modes"]},
              "then": {"properties": {"pii_redacted": {"const": true}}}}]},
  "shop": {"type": "object", "additionalProperties": false, "required": ["name", "platforms", "disclosure"],
   "properties": {"name": {"type": "string", "maxLength": 120},
                  "platforms": {"type": "array", "minItems": 1, "items": {"enum": ["facebook", "instagram", "zalo", "tiktok", "website"]}},
                  "business_model": {"enum": ["maker", "reseller", "service", "mixed"]},
                  "contact": {"type": "object", "additionalProperties": false,
                              "properties": {"phone": {"type": ["string", "null"]}, "address": {"type": ["string", "null"]}, "hours": {"type": ["string", "null"]}}},
                  "disclosure": {"type": "object", "additionalProperties": false, "required": ["ai_label_first_message", "text", "human_keyword"],
                                 "properties": {"ai_label_first_message": {"type": "boolean"}, "text": {"type": "string", "maxLength": 300},
                                                "human_keyword": {"type": "string", "maxLength": 40}}}}},
  "industry": {"type": "object", "additionalProperties": false, "required": ["pack", "risk"],
   "properties": {"pack": {"enum": ["home-decor-wood", "fashion", "cosmetics-skincare", "mom-baby", "fnb", "spa-beauty", "electronics-accessories", "online-course", "health-supplement", "generic"]},
                  "also": {"type": "array", "items": {"type": "string"}}, "skill20_variant": {"type": ["string", "null"]},
                  "risk": {"enum": ["low", "medium", "high"]}, "notes": {"type": "array", "items": {"$ref": "#/$defs/line"}}}},
  "bot_profile": {"type": "object", "additionalProperties": false, "required": ["tool_use", "vision", "context", "reasoning", "tier_hint", "basis"],
   "properties": {"tool_use": {"enum": ["low", "medium", "high"]}, "vision": {"enum": ["none", "nice_to_have", "required"]},
                  "context": {"enum": ["short", "medium", "long"]}, "reasoning": {"enum": ["low", "medium", "high"]},
                  "tier_hint": {"enum": ["economy", "standard", "premium"]}, "basis": {"const": "heuristic"},
                  "verify_with": {"const": "backtest"}, "why": {"type": "string", "maxLength": 300}}},
  "voice": {"type": "object", "additionalProperties": false, "required": ["tone", "self", "customer", "max_sentences"],
   "properties": {"tone": {"enum": ["friendly", "professional", "playful"]}, "self": {"type": "string", "maxLength": 20},
                  "customer": {"type": "string", "maxLength": 40}, "sentence_end": {"type": ["string", "null"], "maxLength": 10},
                  "emoji": {"enum": ["none", "rare", "ok"]}, "max_sentences": {"type": "integer", "minimum": 1, "maximum": 6},
                  "one_question_per_message": {"type": "boolean"}, "avoid": {"type": "array", "items": {"$ref": "#/$defs/line"}},
                  "examples": {"type": "array", "maxItems": 20,
                               "items": {"type": "object", "additionalProperties": false, "required": ["situation", "good"],
                                         "properties": {"situation": {"type": "string", "maxLength": 120}, "good": {"type": "string", "maxLength": 600},
                                                        "avoid": {"type": "string", "maxLength": 600}}}}}},
  "policy": {"type": "object", "additionalProperties": false, "required": ["id", "topic", "status"],
   "properties": {"id": {"$ref": "#/$defs/id"},
                  "topic": {"enum": ["shipping", "returns", "warranty", "payment", "production_time", "custom_order", "wholesale", "showroom", "invoice", "other"]},
                  "status": {"enum": ["confirmed", "missing", "conflict"]}, "text": {"type": ["string", "null"], "maxLength": 900},
                  "source": {"type": ["string", "null"], "pattern": "^S[0-9]+$"}, "ask_owner": {"type": "string", "maxLength": 240}},
   "allOf": [{"if": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]},
              "then": {"properties": {"text": {"type": "string", "minLength": 1}, "source": {"type": "string"}}, "required": ["text", "source"]}}]},
  "price_policy": {"type": "object", "additionalProperties": false, "required": ["source_of_truth", "reveal", "never_disclose", "promotions"],
   "properties": {"source_of_truth": {"enum": ["pos", "owner_sheet"]}, "reveal": {"enum": ["only_when_asked", "proactive_ok"]},
                  "quote": {"enum": ["exact_variant", "range_if_unspecified"]}, "bargaining": {"enum": ["no_discount", "handoff", "approved_rules"]},
                  "never_disclose": {"type": "array", "items": {"enum": ["stock_quantity", "cost_price", "supplier"]}},
                  "promotions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "valid_to", "approved_by"],
                                 "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "maxLength": 300}, "valid_from": {"$ref": "#/$defs/date"},
                                                "valid_to": {"$ref": "#/$defs/date"}, "approved_by": {"type": "string", "minLength": 1}}}}}},
  "product": {"type": "object", "additionalProperties": false, "required": ["id", "match", "label", "facts"],
   "properties": {"id": {"$ref": "#/$defs/id"},
                  "match": {"type": "object", "additionalProperties": false, "required": ["name_patterns"],
                            "properties": {"external_product_id": {"type": ["string", "null"]}, "sku_prefix": {"type": ["string", "null"]},
                                           "name_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 80}}}},
                  "label": {"type": "string", "maxLength": 120}, "category": {"type": "string", "maxLength": 60},
                  "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "value", "evidence", "source"],
                            "properties": {"key": {"$ref": "#/$defs/id"}, "value": {"type": "string", "maxLength": 200}, "unit": {"type": ["string", "null"], "maxLength": 20},
                                           "evidence": {"$ref": "#/$defs/evidence"}, "source": {"$ref": "#/$defs/ref"}}}},
                  "uses": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "not_for": {"type": "array", "items": {"$ref": "#/$defs/line"}},
                  "missing_facts": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "faq_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
  "post_map": {"type": "object", "additionalProperties": false, "required": ["post_hint", "product_ids", "confidence", "source"],
   "properties": {"post_id": {"type": ["string", "null"]}, "post_hint": {"type": "string", "maxLength": 160},
                  "product_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
                  "confidence": {"enum": ["high", "medium", "low"]}, "source": {"$ref": "#/$defs/ref"}}},
  "surface_rules": {"type": "object", "additionalProperties": false, "required": ["max_sentences", "pii", "capabilities", "rules"],
   "properties": {"max_sentences": {"type": "integer", "minimum": 1, "maximum": 6},
                  "pii": {"type": "object", "additionalProperties": false, "required": ["request", "repeat"],
                          "properties": {"request": {"enum": ["after_buy_signal", "never"]}, "repeat": {"enum": ["confirm_only", "never"]}}},
                  "capabilities": {"type": "array", "items": {"enum": ["product_lookup", "availability_check", "shipping_estimate", "send_images", "cart", "create_order", "order_status", "payment_check", "handoff"]}},
                  "must_invite_inbox": {"type": "boolean"}, "rules": {"type": "array", "items": {"$ref": "#/$defs/line"}}},
   "allOf": [{"if": {"properties": {"pii": {"properties": {"request": {"const": "never"}}, "required": ["request"]}}, "required": ["pii"]},
              "then": {"properties": {"capabilities": {"items": {"not": {"enum": ["cart", "create_order", "order_status", "payment_check"]}}}}}}]},
  "intent": {"type": "object", "additionalProperties": false, "required": ["id", "label", "surfaces", "stage", "utterances", "resolve", "next"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "maxLength": 80},
                  "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
                  "stage": {"enum": ["greet", "discover", "recommend", "objection", "close", "post_sale", "support"]},
                  "utterances": {"$ref": "#/$defs/utterances"},
                  "frequency": {"type": "object", "additionalProperties": false,
                                "properties": {"count": {"type": ["integer", "null"], "minimum": 0}, "share": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "evidence": {"$ref": "#/$defs/evidence"}}},
                  "resolve": {"enum": ["pos_lookup", "knowledge", "policy", "ask_back", "handoff"]},
                  "rules": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "templates": {"type": "array", "items": {"$ref": "#/$defs/template"}},
                  "next": {"enum": ["ask_need", "recommend", "send_images", "invite_inbox", "close", "handoff", "end"]}}},
  "faq": {"type": "object", "additionalProperties": false, "required": ["id", "q", "a", "scope", "evidence", "source"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "q": {"type": "string", "maxLength": 200}, "a": {"type": "string", "maxLength": 700},
                  "aliases_ascii": {"type": "string", "maxLength": 300}, "scope": {"enum": ["shop", "product", "policy"]},
                  "product_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "evidence": {"$ref": "#/$defs/evidence"},
                  "source": {"$ref": "#/$defs/ref"}, "evidence_count": {"type": "integer", "minimum": 0}}},
  "objection": {"type": "object", "additionalProperties": false, "required": ["id", "label", "utterances", "real_worry", "moves", "do_not", "evidence"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "maxLength": 80}, "utterances": {"$ref": "#/$defs/utterances"},
                  "real_worry": {"type": "string", "maxLength": 200},
                  "moves": {"type": "array", "minItems": 2, "maxItems": 5,
                            "items": {"type": "object", "additionalProperties": false, "required": ["step", "text"],
                                      "properties": {"step": {"enum": ["acknowledge", "clarify", "evidence", "option", "soft_close"]}, "text": {"type": "string", "maxLength": 400}}}},
                  "proof_needed": {"type": ["string", "null"], "maxLength": 160}, "do_not": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}},
                  "handoff_if": {"type": ["string", "null"], "maxLength": 160}, "evidence": {"$ref": "#/$defs/evidence"},
                  "evidence_count": {"type": "integer", "minimum": 0}}},
  "closing": {"type": "object", "additionalProperties": false, "required": ["buy_signals", "steps", "stop_rule"],
   "properties": {"buy_signals": {"$ref": "#/$defs/utterances"}, "not_buy_signals": {"type": "array", "items": {"type": "string", "maxLength": 120}},
                  "steps": {"type": "array", "minItems": 3,
                            "items": {"type": "object", "additionalProperties": false, "required": ["id", "goal", "allowed_when", "text"],
                                      "properties": {"id": {"$ref": "#/$defs/id"}, "goal": {"type": "string", "maxLength": 120}, "allowed_when": {"type": "string", "maxLength": 160},
                                                     "text": {"type": "string", "maxLength": 400},
                                                     "collect": {"type": "array", "items": {"enum": ["receiver_name", "phone", "address", "size_or_variant", "quantity", "payment_method", "note"]}}}}},
                  "soft_lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "stop_rule": {"$ref": "#/$defs/line"}}},
  "handoff": {"type": "object", "additionalProperties": false, "required": ["id", "trigger", "condition", "bot_message", "priority"],
   "properties": {"id": {"$ref": "#/$defs/id"},
                  "trigger": {"enum": ["human_request", "complaint", "refund_return", "custom_quote", "wholesale", "negative_comment", "incident_safety", "payment_issue", "missing_info", "bot_loop", "abuse", "other"]},
                  "condition": {"$ref": "#/$defs/line"}, "bot_message": {"type": "string", "maxLength": 300},
                  "payload": {"type": "array", "items": {"enum": ["summary", "product", "size_or_variant", "quantity", "contact_if_given", "customer_quote", "images_seen"]}},
                  "priority": {"enum": ["normal", "urgent"]}}},
  "never_say": {"type": "object", "additionalProperties": false, "required": ["id", "rule", "kind", "severity", "why"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "rule": {"$ref": "#/$defs/line"}, "kind": {"enum": ["legal", "platform", "owner_pref", "safety", "accuracy", "reputation"]},
                  "severity": {"enum": ["hard", "soft"]}, "why": {"$ref": "#/$defs/line"}, "source": {"type": "string", "maxLength": 120}, "instead": {"$ref": "#/$defs/line"}}},
  "autonomy": {"type": "object", "additionalProperties": false, "required": ["requires_named_approval", "always_human", "kill_switch"],
   "properties": {"requires_named_approval": {"const": true}, "approval_ref": {"type": ["string", "null"], "maxLength": 160},
                  "always_human": {"type": "array", "minItems": 1, "items": {"enum": ["human_request", "complaint", "refund_return", "negative_comment", "incident_safety", "abuse", "payment_issue"]}},
                  "kill_switch": {"type": "object", "additionalProperties": false, "required": ["who", "how", "target_minutes"],
                                  "properties": {"who": {"type": "array", "minItems": 2, "items": {"type": "string", "maxLength": 80}}, "how": {"$ref": "#/$defs/line"},
                                                 "target_minutes": {"type": "integer", "minimum": 1, "maximum": 60}}}}},
  "conversation": {"type": "object", "additionalProperties": false, "required": ["id", "title", "surface", "messages"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "maxLength": 120}, "surface": {"$ref": "#/$defs/surface"},
                  "messages": {"$ref": "#/$defs/messages"}, "notes": {"type": "string", "maxLength": 300}}},
  "missing": {"type": "object", "additionalProperties": false, "required": ["path", "ask", "priority", "until_answered"],
   "properties": {"path": {"type": "string", "maxLength": 80}, "ask": {"$ref": "#/$defs/line"}, "priority": {"enum": ["blocker", "important", "nice"]}, "until_answered": {"$ref": "#/$defs/line"}}},
  "eval_case": {"type": "object", "additionalProperties": false, "required": ["id", "name", "surface", "messages", "expect"],
   "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "maxLength": 120}, "surface": {"$ref": "#/$defs/surface"}, "messages": {"$ref": "#/$defs/messages"},
                  "expect": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/line"}}, "must_not": {"type": "array", "items": {"$ref": "#/$defs/line"}}}},
  "exports": {"type": "object", "additionalProperties": false,
   "properties": {"opa_agent": {"type": "object", "additionalProperties": false, "required": ["ai_config_patch", "knowledge_documents"],
    "properties": {"ai_config_patch": {"type": "object", "additionalProperties": false,
                    "properties": {"tone": {"enum": ["friendly", "professional", "playful"]}, "systemPrompt": {"type": "string", "maxLength": 8000},
                                   "salesMode": {"enum": ["flexible", "strict", "off"]},
                                   "brandVoiceExamples": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 1000}}}},
                   "knowledge_documents": {"type": "array", "maxItems": 200,
                    "items": {"type": "object", "additionalProperties": false, "required": ["sourceType", "title", "content"],
                              "properties": {"sourceType": {"enum": ["faq", "policy"]}, "title": {"type": "string", "minLength": 1, "maxLength": 200},
                                             "content": {"type": "string", "minLength": 1, "maxLength": 20000}, "origin": {"type": "string", "maxLength": 60}}}}}}}}
 }
}
